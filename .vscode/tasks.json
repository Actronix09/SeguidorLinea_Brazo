{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Compile Quartus",
            "type": "shell",
            "command": "C:\\altera\\13.0sp1\\quartus\\bin64\\quartus_sh.exe",
            "args": [
                "--flow",
                "compile",
                "SeguidorLinea_Brazo"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "options": {
                "statusbar": {
                    "label": "$(tools) Compile Quartus",
                    "tooltip": "Compilar proyecto Quartus (quartus_sh --flow compile)",
                    "color": "#7CB7FF"
                }
            }
        },
        {
            "label": "Program FPGA",
            "type": "shell",
            "command": "C:\\altera\\13.0sp1\\quartus\\bin64\\quartus_pgm.exe",
            "args": [
                "-m",
                "jtag",
                "-c",
                "1",
                "-o",
                { "value": "p;output_files\\SeguidorLinea_Brazo.sof", "quoting": "strong" }
            ],
            "presentation": {
                "reveal": "always",
                "panel": "dedicated",
                "clear": true
            },
            "options": {
                "statusbar": {
                    "label": "$(zap) Program FPGA",
                    "tooltip": "Programar FPGA via JTAG (quartus_pgm -m jtag -c 1)",
                    "color": "#FFD700"
                }
            }
        }
    ]
}