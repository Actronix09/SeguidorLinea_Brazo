-- ============================================================================
-- Robot - Módulo Principal - Solo Servos a 90 grados
-- FPGA: Cyclone IV EP4CE6E22C8 | Placa: RZ-EasyFPGA A2.2 | Reloj: 50 MHz
-- ============================================================================
-- Descripción: Versión simplificada que solo posiciona todos los servos a 90°
-- ============================================================================

library IEEE;
use IEEE.STD_LOGIC_1164.ALL;
use IEEE.NUMERIC_STD.ALL;

-- ============================================================================
-- ENTITY: SeguidorLinea_Brazo_Servos90
-- ============================================================================
entity SeguidorLinea_Brazo_Servos90 is
Port (
    -- Señales de control
    clk     : in  std_logic;
    reset   : in  std_logic;
    
    -- Servomotores (4 ejes)
    servo_phi     : out std_logic;
    servo_theta1  : out std_logic;
    servo_theta2  : out std_logic;
    servo_theta3  : out std_logic;
    servo_gripper : out std_logic
);
end SeguidorLinea_Brazo_Servos90;

-- ============================================================================
-- ARCHITECTURE: Behavioral
-- ============================================================================
architecture Behavioral of SeguidorLinea_Brazo_Servos90 is

-- Componente: polarPWM (control de servos)
component polarPWM
Port (
    clk         : in  std_logic;
    rst         : in  std_logic;
    phi_in      : in  std_logic_vector(7 downto 0);
    theta_in    : in  std_logic_vector(7 downto 0);
    radio_in    : in  std_logic_vector(7 downto 0);
    gripper_in  : in  std_logic_vector(7 downto 0);
    pwm_phi     : out std_logic;
    pwm_theta1  : out std_logic;
    pwm_theta2  : out std_logic;
    pwm_theta3  : out std_logic
);
end component;

-- Señales internas: valores fijos a 90 grados (128 = 90° en mapeo 0-255)
signal phi_in      : std_logic_vector(7 downto 0) := x"80";  -- 90°
signal theta_in    : std_logic_vector(7 downto 0) := x"80";  -- 90°
signal radio_in    : std_logic_vector(7 downto 0) := x"80";  -- 90°
signal gripper_in  : std_logic_vector(7 downto 0) := x"80";  -- 90°

-- Reset activo bajo
signal reset_int : std_logic;

begin

-- Reset activo bajo
reset_int <= not reset;

-- polarPWM: control de servomotores
u_polarPWM : polarPWM
Port Map (
    clk         => clk,
    rst         => reset_int,
    phi_in      => phi_in,
    theta_in    => theta_in,
    radio_in    => radio_in,
    gripper_in  => gripper_in,
    pwm_phi     => servo_phi,
    pwm_theta1  => servo_theta1,
    pwm_theta2  => servo_theta2,
    pwm_theta3  => servo_theta3
);

-- El gripper se controla directamente
servo_gripper <= '1';

end Behavioral;
