-- ============================================================================
-- LIDAR - Wrapper de integración del driver VL53L0X (ETAPA 2)
-- FPGA: Cyclone II EP2C5T144C7 | Placa: RZ-EasyFPGA A2.2 | Reloj: 50 MHz
-- ----------------------------------------------------------------------------
-- Adapta el driver VL53L0X (medición continua de distancia) a la interfaz del
-- componente 'LIDAR' que ya instancia SeguidorLinea_Brazo.vhd, de modo que el
-- top NO necesita modificarse.
--
--   best_distance <- distancia en mm saturada a 8 bits (0..255). Compatible con
--                    las comparaciones <50 / <200 mm de MaquinaEstados.
--   scan_complete <- data_valid (hay medición válida disponible).
--   best_phi/best_theta <- fijos a 90° (sin barrido angular en modo mínimo).
--   current_state <- err_code(3:0) (visibilidad de error para depuración).
--   rst es activo ALTO (recibe reset_int del top); start_scan se ignora
--   (el driver mide en bucle continuo).
-- ============================================================================

library IEEE;
use IEEE.STD_LOGIC_1164.ALL;
use IEEE.NUMERIC_STD.ALL;

entity LIDAR is
    port (
        clk           : in    std_logic;
        rst           : in    std_logic;                     -- activo ALTO
        start_scan    : in    std_logic;                     -- ignorado (modo continuo)
        i2c_scl       : out   std_logic;
        i2c_sda       : inout std_logic;
        best_phi      : out   std_logic_vector(7 downto 0);
        best_theta    : out   std_logic_vector(7 downto 0);
        best_distance : out   std_logic_vector(7 downto 0);
        scan_complete : out   std_logic;
        current_state : out   std_logic_vector(3 downto 0)
    );
end LIDAR;

architecture Behavioral of LIDAR is

    component VL53L0X
        generic (
            CLK_FREQ_HZ  : integer := 50_000_000;
            I2C_FREQ_HZ  : integer := 100_000;
            PWRUP_CYCLES : integer := 500_000
        );
        port (
            clk         : in    std_logic;
            rst         : in    std_logic;
            i2c_scl     : out   std_logic;
            i2c_sda     : inout std_logic;
            distance_mm : out   std_logic_vector(15 downto 0);
            data_valid  : out   std_logic;
            sensor_ok   : out   std_logic;
            err_code    : out   std_logic_vector(4 downto 0);
            meas_tick   : out   std_logic
        );
    end component;

    signal distance_s : std_logic_vector(15 downto 0);
    signal valid_s    : std_logic;
    signal err_s      : std_logic_vector(4 downto 0);

begin

    u_VL53L0X : VL53L0X
        port map (
            clk         => clk,
            rst         => rst,
            i2c_scl     => i2c_scl,
            i2c_sda     => i2c_sda,
            distance_mm => distance_s,
            data_valid  => valid_s,
            sensor_ok   => open,
            err_code    => err_s,
            meas_tick   => open
        );

    -- Distancia saturada a 8 bits (0..255 mm)
    best_distance <= x"FF" when unsigned(distance_s) > 255
                     else distance_s(7 downto 0);

    best_phi      <= x"5A";                 -- 90° (sin barrido angular)
    best_theta    <= x"5A";                 -- 90°
    scan_complete <= valid_s;
    current_state <= err_s(3 downto 0);

end Behavioral;
