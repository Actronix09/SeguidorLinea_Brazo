-- ============================================================================
-- MaquinaEstados - Cerebro de Sísifo (Etapa 2): seguidor de línea + orquestación
--                  del brazo (buscar/agarrar/depositar) en pista cerrada en loop.
-- FPGA: Cyclone II EP2C5T144C7 | Sensores: QRD1114 x2 | Puente H: L293 | 50 MHz
-- ----------------------------------------------------------------------------
-- Motores: control BIDIRECCIONAL por PWM en las 4 entradas A1/A2/B1/B2 del L293
-- (enables fijos en HW).  Adelante: INx1=PWM, INx2=0.  Reversa: INx1=0, INx2=PWM.
--
-- Seguidor (2 QRD, sensor sobre la LÍNEA negra = LINE_LVL):
--   - ambos fuera de línea -> ambos motores ADELANTE a MAX (recto).
--   - un sensor toma la línea -> la rueda de ESE lado gira en REVERSA (fracción
--     VEL_REV) y la otra ADELANTE a MAX  => pivot rápido hacia la línea.
--   - el lado a corregir queda LATCHEADO hasta que el sensor CONTRARIO toma la
--     línea (ahí se invierte la corrección).
--   - zona (cuadrado negro ~7 cm = ambos sensores en negro sostenido) -> se
--     detiene y, según 'has_object': sin objeto dispara el LIDAR (start_scan);
--     con objeto deposita (trigger_drop). Luego AVANZA hasta dejar el cuadro y sigue.
--
-- NOTA: el nivel del sensor sobre la línea se fija con LINE_LVL (en este robot='0').
-- ============================================================================

library IEEE;
use IEEE.STD_LOGIC_1164.ALL;
use IEEE.NUMERIC_STD.ALL;

entity MaquinaEstados is
    generic (
        MAX_SPEED        : integer := 240;     -- duty máximo ADELANTE (0..255)
        VEL_REV          : integer := 60;      -- magnitud de REVERSA de la rueda interior al corregir
        VEL_SALIR        : integer := 130;     -- duty (adelante) al salir de la zona
        PWM_PRESCALE     : integer := 20;      -- divisor del tick PWM (~9.7 kHz)
        ZONA_CYCLES      : integer := 2_000_000;    -- ambos negro sostenido => zona (40 ms)
        SALIR_CYCLES     : integer := 10_000_000;   -- margen tras DEJAR el cuadro negro (0.2 s)
        LINE_LVL         : std_logic := '1'    -- nivel del sensor SOBRE la línea
    );
    port (
        clk          : in  std_logic;
        rst          : in  std_logic;          -- activo alto
        sensor_izq   : in  std_logic;
        sensor_der   : in  std_logic;
        -- motores (PWM directo en las entradas del L293)
        motor_a1     : out std_logic;          -- motor IZQ adelante
        motor_a2     : out std_logic;          -- motor IZQ reversa
        motor_b1     : out std_logic;          -- motor DER adelante
        motor_b2     : out std_logic;          -- motor DER reversa
        -- interfaz con el brazo/LIDAR
        start_scan   : out std_logic;          -- pulso: dispara el barrido
        trigger_drop : out std_logic;          -- pulso: deposita el objeto
        scan_active  : in  std_logic;          -- '1' mientras el LIDAR barre
        arm_ready    : in  std_logic;          -- '1' cuando el brazo está libre/HOLD
        has_object   : in  std_logic;          -- '1' si lleva el cubo
        -- LEDs
        led_estado   : out std_logic;          -- parpadeo 1 Hz
        led_error    : out std_logic
    );
end MaquinaEstados;

architecture rtl of MaquinaEstados is

    -- Sensores registrados (antirrebote 1 ciclo), normalizados a '1' = sobre línea
    signal s_izq, s_der : std_logic := '0';
    signal ambos_linea  : std_logic := '0';   -- ambos sobre línea (candidato a zona)

    -- Velocidades objetivo y actuales CON SIGNO: + adelante, - reversa, 0 freno.
    signal tgt_l, tgt_r : integer range -255 to 255 := 0;
    signal cur_l, cur_r : integer range -255 to 255 := 0;

    -- Lado a corregir LATCHEADO: la reducción de un motor persiste hasta que el
    -- sensor CONTRARIO toma la línea (recién ahí se cancela y vuelve a MAX).
    type corr_t is (C_NONE, C_LEFT, C_RIGHT);
    signal corr_side : corr_t := C_NONE;

    -- PWM
    signal pre_cnt  : integer range 0 to PWM_PRESCALE-1 := 0;
    signal pwm_cnt  : integer range 0 to 255 := 0;

    -- Detección de zona / salida
    signal zona_cnt  : integer range 0 to ZONA_CYCLES := 0;
    signal salir_cnt : integer range 0 to SALIR_CYCLES := 0;

    -- FSM
    type est_t is (E_INICIO, E_SEGUIR, E_ZONA, E_SCAN_INI, E_SCAN_FIN,
                   E_DROP_WAIT, E_SALIR_ZONA);
    signal est : est_t := E_INICIO;

    signal start_scan_r   : std_logic := '0';
    signal trigger_drop_r : std_logic := '0';

    -- 1 Hz
    signal clk_1s : std_logic := '0';
    signal cnt_1s : integer range 0 to 24_999_999 := 0;

begin

    -- =========================================================================
    -- Generador 1 Hz (LED de vida)
    -- =========================================================================
    p_1hz : process(clk, rst)
    begin
        if rst = '1' then
            cnt_1s <= 0; clk_1s <= '0';
        elsif rising_edge(clk) then
            if cnt_1s = 24_999_999 then
                cnt_1s <= 0; clk_1s <= not clk_1s;
            else
                cnt_1s <= cnt_1s + 1;
            end if;
        end if;
    end process;

    -- =========================================================================
    -- Velocidad aplicada: respuesta INMEDIATA (el motor suaviza por inercia).
    -- tgt con signo: + adelante, - reversa, 0 freno.  Corrección rápida = pivot.
    -- =========================================================================
    p_vel : process(clk, rst)
    begin
        if rst = '1' then
            cur_l <= 0; cur_r <= 0;
        elsif rising_edge(clk) then
            cur_l <= tgt_l;
            cur_r <= tgt_r;
        end if;
    end process;

    -- =========================================================================
    -- Generador PWM (8 bits, prescalado) - bidireccional según el signo de cur_*
    -- =========================================================================
    p_pwm : process(clk, rst)
    begin
        if rst = '1' then
            pre_cnt <= 0; pwm_cnt <= 0;
        elsif rising_edge(clk) then
            if pre_cnt = PWM_PRESCALE-1 then
                pre_cnt <= 0;
                if pwm_cnt = 255 then pwm_cnt <= 0; else pwm_cnt <= pwm_cnt + 1; end if;
            else
                pre_cnt <= pre_cnt + 1;
            end if;
        end if;
    end process;

    -- cur > 0: adelante (INx1=PWM); cur < 0: reversa (INx2=PWM); cur = 0: freno (ambas 0)
    motor_a1 <= '1' when (cur_l > 0 and pwm_cnt <  cur_l) else '0';
    motor_a2 <= '1' when (cur_l < 0 and pwm_cnt < -cur_l) else '0';
    motor_b1 <= '1' when (cur_r > 0 and pwm_cnt <  cur_r) else '0';
    motor_b2 <= '1' when (cur_r < 0 and pwm_cnt < -cur_r) else '0';

    -- =========================================================================
    -- FSM principal: seguidor + zonas + orquestación del brazo
    -- =========================================================================
    fsm : process(clk, rst)
    begin
        if rst = '1' then
            est <= E_INICIO;
            tgt_l <= 0; tgt_r <= 0;
            corr_side <= C_NONE;
            s_izq <= '0'; s_der <= '0'; ambos_linea <= '0';
            zona_cnt <= 0; salir_cnt <= 0;
            start_scan_r <= '0'; trigger_drop_r <= '0';
        elsif rising_edge(clk) then
            -- pulsos por defecto a '0'
            start_scan_r   <= '0';
            trigger_drop_r <= '0';

            -- registro/normalización de sensores ('1' = sobre la línea)
            if sensor_izq = LINE_LVL then s_izq <= '1'; else s_izq <= '0'; end if;
            if sensor_der = LINE_LVL then s_der <= '1'; else s_der <= '0'; end if;
            if sensor_izq = LINE_LVL and sensor_der = LINE_LVL then
                ambos_linea <= '1';
            else
                ambos_linea <= '0';
            end if;

            -- contador de zona (ambos sobre línea sostenido)
            if ambos_linea = '1' then
                if zona_cnt < ZONA_CYCLES then zona_cnt <= zona_cnt + 1; end if;
            else
                zona_cnt <= 0;
            end if;

            case est is

                when E_INICIO =>
                    tgt_l <= 0; tgt_r <= 0;
                    est <= E_SEGUIR;

                -- ---- Seguir la línea con corrección por PIVOT (rueda interior en reversa) ----
                -- El lado a corregir queda LATCHEADO hasta que el sensor CONTRARIO toma
                -- la línea: esa rueda gira en REVERSA (-VEL_REV) y la otra ADELANTE a MAX
                -- => giro rápido hacia la línea. Recto = ambas adelante a MAX.
                when E_SEGUIR =>
                    if zona_cnt >= ZONA_CYCLES then
                        est <= E_ZONA;

                    else
                        -- NUEVA LÓGICA:
                        -- Los sensores van centrados sobre la línea.
                        -- Ambos sensores sobre línea = avanzar recto.
                        -- Si el izquierdo sale de la línea, corregir a la izquierda.
                        -- Si el derecho sale de la línea, corregir a la derecha.

                        if s_izq = '0' and s_der = '0' then
                            -- centrado sobre la línea
                            tgt_l <= MAX_SPEED;
                            tgt_r <= MAX_SPEED;

                        elsif s_izq = '1' and s_der = '0' then
                            -- se salió por la izquierda
                            tgt_l <= VEL_SALIR;
                            tgt_r <= MAX_SPEED;

                        elsif s_izq = '0' and s_der = '1' then
                            -- se salió por la derecha
                            tgt_l <= MAX_SPEED;
                            tgt_r <= VEL_SALIR;

                        else
                            -- ambos fuera
                            tgt_l <= VEL_SALIR;
                            tgt_r <= VEL_SALIR;
                        end if;
                    end if;

                -- ---- En la zona: detener y decidir según acarreo ----
                when E_ZONA =>
                    tgt_l <= 0; tgt_r <= 0;
                    corr_side <= C_NONE;                -- al salir de la zona, retoma recto
                    if has_object = '0' then
                        start_scan_r <= '1';            -- busca+agarra
                        est <= E_SCAN_INI;
                    else
                        trigger_drop_r <= '1';          -- deposita
                        est <= E_DROP_WAIT;
                    end if;

                when E_SCAN_INI =>                       -- espera que arranque el barrido
                    tgt_l <= 0; tgt_r <= 0;
                    if scan_active = '1' then
                        est <= E_SCAN_FIN;
                    end if;

                when E_SCAN_FIN =>                       -- espera que el brazo termine
                    tgt_l <= 0; tgt_r <= 0;
                    if arm_ready = '1' then
                        salir_cnt <= 0;
                        est <= E_SALIR_ZONA;
                    end if;

                when E_DROP_WAIT =>                      -- espera a que suelte el cubo
                    tgt_l <= 0; tgt_r <= 0;
                    if has_object = '0' then
                        salir_cnt <= 0;
                        est <= E_SALIR_ZONA;
                    end if;

                -- ---- Salir de la zona: avanza recto hasta DEJAR el cuadro negro ----
                -- (independiente del tamaño: el cuadro de 7 cm se cruza por completo).
                -- Una vez fuera del negro (ambos_linea='0') espera un margen y reanuda;
                -- así no vuelve a disparar la MISMA zona.
                when E_SALIR_ZONA =>
                    tgt_l <= VEL_SALIR; tgt_r <= VEL_SALIR;
                    if ambos_linea = '0' then               -- ya salió del cuadro negro
                        if salir_cnt >= SALIR_CYCLES-1 then
                            est <= E_SEGUIR;
                        else
                            salir_cnt <= salir_cnt + 1;     -- margen tras salir
                        end if;
                    else
                        salir_cnt <= 0;                     -- aún sobre el negro: sigue avanzando
                    end if;

            end case;
        end if;
    end process;

    start_scan   <= start_scan_r;
    trigger_drop <= trigger_drop_r;
    led_estado   <= clk_1s;
    led_error    <= '0';

end rtl;
