-- ============================================================================
-- MaquinaEstados - Cerebro de Sísifo (Etapa 2): seguidor de línea + orquestación
--                  del brazo (buscar/agarrar/depositar) en pista cerrada en loop.
-- FPGA: Cyclone II EP2C5T144C7 | Sensores: QRD1114 x2 | Puente H: L293 | 50 MHz
-- ----------------------------------------------------------------------------
-- Motores: control ON/OFF (SIN velocidades dinámicas). Cada rueda va ENCENDIDA
--   (adelante, duty = MAX_SPEED) o APAGADA. Para girar se APAGA la rueda interior
--   (queda FRENADA por el L293) y la otra sigue encendida => pivote firme sin
--   sacrificar torque. Adelante: INx1=PWM(MAX_SPEED), INx2=0. Apagada: INx1=INx2=0.
--   La ÚNICA perilla de velocidad es MAX_SPEED (0..255). Se ajusta en el generic map
--   del top (SeguidorLinea_Brazo.vhd): subirla = más rápido, 255 = máximo.
--
-- Seguidor con SENSORES SEPARADOS (la línea negra pasa ENTRE los 2 QRD;
--   s_*='1' = ese sensor ve NEGRO = está SOBRE la línea):
--   - (0,0) ambos en BLANCO = centrados (línea entre medio) -> ambos ADELANTE (recto).
--   - (1,0) el IZQ pisa la línea -> robot derivó a la DERECHA -> girar IZQUIERDA
--           (apaga rueda IZQ, DER encendida).
--   - (0,1) el DER pisa la línea -> robot derivó a la IZQUIERDA -> girar DERECHA
--           (apaga rueda DER, IZQ encendida).
--   - si pierde la línea (ambos en blanco) -> va RECTO (NO gira en círculos).
--     Gira solo MIENTRAS un sensor ve la línea. Predecible (sin latch). En una curva
--     el sensor de ese lado sigue tomando la línea y la sigue; si una curva es muy
--     cerrada y se sale, baja MAX_SPEED.
--   - zona (cuadrado negro = AMBOS en negro SOSTENIDO ZONA_CYCLES) -> se detiene y,
--     según 'has_object': sin objeto dispara el LIDAR (start_scan); con objeto
--     deposita (trigger_drop). Luego AVANZA hasta dejar el cuadro y sigue.
--     (Con sensores separados "ambos negro" solo ocurre en el cuadro -> zona fiable.)
--
-- NOTA: el nivel del sensor sobre la línea se fija con LINE_LVL (en este robot='0').
-- ============================================================================

library IEEE;
use IEEE.STD_LOGIC_1164.ALL;
use IEEE.NUMERIC_STD.ALL;

entity MaquinaEstados is
    generic (
        MAX_SPEED        : integer := 175;     -- ÚNICA velocidad: duty ADELANTE (0..255)
        PWM_PRESCALE     : integer := 15;      -- divisor del tick PWM (~9.7 kHz)
        ZONA_CYCLES      : integer := 2_000_000;    -- ambos negro sostenido => zona (40 ms)
        SALIR_CYCLES     : integer := 10_000_000;   -- margen tras DEJAR el cuadro negro (0.2 s)
        LINE_LVL         : std_logic := '0'    -- nivel del sensor SOBRE la línea
    );
    port (
        clk          : in  std_logic;
        rst          : in  std_logic;          -- activo alto
        sensor_izq   : in  std_logic;
        sensor_der   : in  std_logic;
        -- motores (PWM directo en las entradas del L293)
        motor_a1     : out std_logic;          -- motor IZQ adelante
        motor_a2     : out std_logic;          -- motor IZQ reversa (sin uso: siempre '0')
        motor_b1     : out std_logic;          -- motor DER adelante
        motor_b2     : out std_logic;          -- motor DER reversa (sin uso: siempre '0')
        -- interfaz con el brazo/LIDAR
        start_scan   : out std_logic;          -- pulso: dispara el barrido
        trigger_drop : out std_logic;          -- pulso: deposita el objeto
        scan_active  : in  std_logic;          -- '1' mientras el LIDAR barre
        arm_ready    : in  std_logic;          -- '1' cuando el brazo está libre/HOLD
        has_object   : in  std_logic;          -- '1' si lleva el cubo
        -- LEDs
        led_estado   : out std_logic;          -- parpadeo 1 Hz
        led_error    : out std_logic
    );
end MaquinaEstados;

architecture rtl of MaquinaEstados is

    -- Sensores registrados (antirrebote 1 ciclo), normalizados a '1' = sobre línea
    signal s_izq, s_der : std_logic := '0';
    signal ambos_linea  : std_logic := '0';   -- ambos sobre línea (candidato a zona)

    -- Estado ON/OFF de cada rueda (adelante). '1' = encendida a MAX_SPEED, '0' = apagada.
    signal on_l, on_r : std_logic := '0';

    -- PWM (fija la velocidad de marcha = duty MAX_SPEED cuando la rueda está ON)
    signal pre_cnt  : integer range 0 to PWM_PRESCALE-1 := 0;
    signal pwm_cnt  : integer range 0 to 255 := 0;

    -- Detección de zona / salida
    signal zona_cnt  : integer range 0 to ZONA_CYCLES := 0;
    signal salir_cnt : integer range 0 to SALIR_CYCLES := 0;

    -- FSM
    type est_t is (E_INICIO, E_SEGUIR, E_ZONA, E_SCAN_INI, E_SCAN_FIN,
                   E_DROP_WAIT, E_SALIR_ZONA);
    signal est : est_t := E_INICIO;

    signal start_scan_r   : std_logic := '0';
    signal trigger_drop_r : std_logic := '0';

    -- 1 Hz
    signal clk_1s : std_logic := '0';
    signal cnt_1s : integer range 0 to 24_999_999 := 0;

begin

    -- =========================================================================
    -- Generador 1 Hz (LED de vida)
    -- =========================================================================
    p_1hz : process(clk, rst)
    begin
        if rst = '1' then
            cnt_1s <= 0; clk_1s <= '0';
        elsif rising_edge(clk) then
            if cnt_1s = 24_999_999 then
                cnt_1s <= 0; clk_1s <= not clk_1s;
            else
                cnt_1s <= cnt_1s + 1;
            end if;
        end if;
    end process;

    -- =========================================================================
    -- Generador PWM (8 bits, prescalado). Marca el duty fijo MAX_SPEED.
    -- =========================================================================
    p_pwm : process(clk, rst)
    begin
        if rst = '1' then
            pre_cnt <= 0; pwm_cnt <= 0;
        elsif rising_edge(clk) then
            if pre_cnt = PWM_PRESCALE-1 then
                pre_cnt <= 0;
                if pwm_cnt = 255 then pwm_cnt <= 0; else pwm_cnt <= pwm_cnt + 1; end if;
            else
                pre_cnt <= pre_cnt + 1;
            end if;
        end if;
    end process;

    -- ON/OFF puro: rueda encendida = PWM adelante a MAX_SPEED; apagada = 0 (freno L293).
    -- Nunca hay reversa: motor_a2 / motor_b2 quedan siempre en '0'.
    motor_a1 <= '1' when (on_l = '1' and pwm_cnt < MAX_SPEED) else '0';   -- IZQ adelante
    motor_a2 <= '0';                                                      -- IZQ reversa (sin uso)
    motor_b1 <= '1' when (on_r = '1' and pwm_cnt < MAX_SPEED) else '0';   -- DER adelante
    motor_b2 <= '0';                                                      -- DER reversa (sin uso)

    -- =========================================================================
    -- FSM principal: seguidor + zonas + orquestación del brazo
    -- =========================================================================
    fsm : process(clk, rst)
    begin
        if rst = '1' then
            est <= E_INICIO;
            on_l <= '0'; on_r <= '0';
            s_izq <= '0'; s_der <= '0'; ambos_linea <= '0';
            zona_cnt <= 0; salir_cnt <= 0;
            start_scan_r <= '0'; trigger_drop_r <= '0';
        elsif rising_edge(clk) then
            -- pulsos por defecto a '0'
            start_scan_r   <= '0';
            trigger_drop_r <= '0';

            -- registro/normalización de sensores ('1' = sobre la línea)
            if sensor_izq = LINE_LVL then s_izq <= '1'; else s_izq <= '0'; end if;
            if sensor_der = LINE_LVL then s_der <= '1'; else s_der <= '0'; end if;
            if sensor_izq = LINE_LVL and sensor_der = LINE_LVL then
                ambos_linea <= '1';
            else
                ambos_linea <= '0';
            end if;

            -- contador de zona (ambos sobre línea sostenido)
            if ambos_linea = '1' then
                if zona_cnt < ZONA_CYCLES then zona_cnt <= zona_cnt + 1; end if;
            else
                zona_cnt <= 0;
            end if;

            case est is

                when E_INICIO =>
                    on_l <= '0'; on_r <= '0';
                    est <= E_SEGUIR;

                -- ---- Seguir la línea: SENSORES SEPARADOS, control ON/OFF, SIN latch ----
                -- s_*='1' = ese sensor ve NEGRO (sobre la línea). Gira SOLO mientras un
                -- sensor ve la línea; si la pierde va recto (no gira en círculos).
                --   (1,0) IZQ pisa la línea -> derivó a la DERECHA -> girar IZQ (apaga IZQ).
                --   (0,1) DER pisa la línea -> derivó a la IZQ     -> girar DER (apaga DER).
                --   (0,0) centrado / (1,1) zona en curso          -> ambos ON (recto).
                when E_SEGUIR =>
                    if zona_cnt >= ZONA_CYCLES then
                        est <= E_ZONA;
                    else
                        if s_izq = '1' and s_der = '0' then           -- IZQ sobre línea -> girar IZQ
                            on_l <= '0';                              -- apaga rueda interior (IZQ)
                            on_r <= '1';

                        elsif s_izq = '0' and s_der = '1' then        -- DER sobre línea -> girar DER
                            on_l <= '1';
                            on_r <= '0';                              -- apaga rueda interior (DER)

                        else                                          -- (0,0) centrado o (1,1) zona -> recto
                            on_l <= '1'; on_r <= '1';
                        end if;
                    end if;

                -- ---- En la zona: detener y decidir según acarreo ----
                when E_ZONA =>
                    on_l <= '0'; on_r <= '0';
                    if has_object = '0' then
                        start_scan_r <= '1';            -- busca+agarra
                        est <= E_SCAN_INI;
                    else
                        trigger_drop_r <= '1';          -- deposita
                        est <= E_DROP_WAIT;
                    end if;

                when E_SCAN_INI =>                       -- espera que arranque el barrido
                    on_l <= '0'; on_r <= '0';
                    if scan_active = '1' then
                        est <= E_SCAN_FIN;
                    end if;

                when E_SCAN_FIN =>                       -- espera que el brazo termine
                    on_l <= '0'; on_r <= '0';
                    if arm_ready = '1' then
                        salir_cnt <= 0;
                        est <= E_SALIR_ZONA;
                    end if;

                when E_DROP_WAIT =>                      -- espera a que suelte el cubo
                    on_l <= '0'; on_r <= '0';
                    if has_object = '0' then
                        salir_cnt <= 0;
                        est <= E_SALIR_ZONA;
                    end if;

                -- ---- Salir de la zona: avanza recto hasta DEJAR el cuadro negro ----
                -- Una vez fuera del negro (ambos_linea='0') espera un margen y reanuda;
                -- así no vuelve a disparar la MISMA zona.
                when E_SALIR_ZONA =>
                    on_l <= '1'; on_r <= '1';
                    if ambos_linea = '0' then               -- ya salió del cuadro negro
                        if salir_cnt >= SALIR_CYCLES-1 then
                            est <= E_SEGUIR;
                        else
                            salir_cnt <= salir_cnt + 1;     -- margen tras salir
                        end if;
                    else
                        salir_cnt <= 0;                     -- aún sobre el negro: sigue avanzando
                    end if;

            end case;
        end if;
    end process;

    start_scan   <= start_scan_r;
    trigger_drop <= trigger_drop_r;
    led_estado   <= clk_1s;
    led_error    <= '0';

end rtl;
