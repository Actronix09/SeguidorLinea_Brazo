set_global_assignment -name FAMILY "Cyclone II"
set_global_assignment -name DEVICE EP2C5T144C7
# ETAPA 1 (prueba del escaner con servos reales): top = LIDAR_Scan_Top.
#   Otros tops disponibles (cambiar esta linea para usarlos):
#     LIDAR_Top                  -> debug del sensor (servos como bus de 5 bits)
#     SeguidorLinea_BrazoTestBrazo -> prueba de servos
#     SeguidorLinea_Brazo        -> ETAPA 2 (integracion final)
set_global_assignment -name TOP_LEVEL_ENTITY LIDAR_Scan_Top
set_global_assignment -name ORIGINAL_QUARTUS_VERSION "13.0 SP1"
set_global_assignment -name PROJECT_CREATION_TIME_DATE "13:26:11  MAY 17, 2026"
set_global_assignment -name LAST_QUARTUS_VERSION "13.0 SP1"
set_global_assignment -name VHDL_FILE LIDAR.vhd
set_global_assignment -name VHDL_FILE SeguidorLinea_Brazo.vhd
set_global_assignment -name VHDL_FILE MaquinaEstados.vhd
set_global_assignment -name VHDL_FILE polarPWM.vhd
set_global_assignment -name PROJECT_OUTPUT_DIRECTORY output_files
set_global_assignment -name MIN_CORE_JUNCTION_TEMP 0
set_global_assignment -name MAX_CORE_JUNCTION_TEMP 85
set_global_assignment -name ERROR_CHECK_FREQUENCY_DIVISOR 1
set_global_assignment -name STRATIX_DEVICE_IO_STANDARD "3.3-V LVTTL"
set_location_assignment PIN_17 -to clk
set_location_assignment PIN_144 -to reset
set_global_assignment -name VHDL_FILE SeguidorLinea_BrazoTestBrazo.vhd
set_global_assignment -name VHDL_FILE vl53l0x_pkg.vhd
set_global_assignment -name VHDL_FILE VL53L0X.vhd
set_global_assignment -name VHDL_FILE LIDAR_Top.vhd
set_global_assignment -name VHDL_FILE polar_kin.vhd
set_global_assignment -name VHDL_FILE LIDAR_Scan_Top.vhd
set_location_assignment PIN_142 -to i2c_scl
set_location_assignment PIN_136 -to i2c_sda
set_location_assignment PIN_3 -to led_1
set_location_assignment PIN_7 -to led_2
set_location_assignment PIN_9 -to led_3
set_location_assignment PIN_118 -to servo_phi
set_location_assignment PIN_122 -to servo_theta1
set_location_assignment PIN_126 -to servo_theta2
set_location_assignment PIN_132 -to servo_theta3
set_location_assignment PIN_134 -to servo_gripper
set_global_assignment -name PARTITION_NETLIST_TYPE SOURCE -section_id Top
set_global_assignment -name PARTITION_FITTER_PRESERVATION_LEVEL PLACEMENT_AND_ROUTING -section_id Top
set_global_assignment -name PARTITION_COLOR 16764057 -section_id Top
set_instance_assignment -name WEAK_PULL_UP_RESISTOR ON -to reset
set_instance_assignment -name PARTITION_HIERARCHY root_partition -to | -section_id Top