# ============================================================================
# Proyecto
# ============================================================================

set_global_assignment -name FAMILY "Cyclone II"
set_global_assignment -name DEVICE EP2C5T144C7
set_global_assignment -name TOP_LEVEL_ENTITY TestMotores

# ============================================================================
# Archivos Principales VHDL
# ============================================================================

set_global_assignment -name VHDL_FILE vl53l0x_pkg.vhd
set_global_assignment -name VHDL_FILE VL53L0X.vhd
set_global_assignment -name VHDL_FILE encoder_servo.vhd
set_global_assignment -name VHDL_FILE kinematics.vhd
set_global_assignment -name VHDL_FILE polarPWM.vhd
set_global_assignment -name VHDL_FILE LIDAR.vhd
set_global_assignment -name VHDL_FILE grab_ctrl.vhd
set_global_assignment -name VHDL_FILE MaquinaEstados.vhd
set_global_assignment -name VHDL_FILE SeguidorLinea_Brazo.vhd

# ============================================================================
# Archivos Pruebas VHDL
# ============================================================================

# Brazo
set_global_assignment -name VHDL_FILE Pruebas/Brazo/SeguidorLinea_BrazoTestBrazo.vhd
set_global_assignment -name VHDL_FILE Pruebas/Brazo/tb_grab_ctrl.vhd
set_global_assignment -name VHDL_FILE Pruebas/Brazo/tb_kinematics.vhd

# Lidar
set_global_assignment -name VHDL_FILE Pruebas/Lidar/LIDAR_Grab_Top.vhd
set_global_assignment -name VHDL_FILE Pruebas/Lidar/LIDAR_Scan_Top.vhd

# Motores
set_global_assignment -name VHDL_FILE Pruebas/Motores/TestMotores.vhd

# Seguidor
set_global_assignment -name VHDL_FILE Pruebas/Seguidor/tb_MaquinaEstados.vhd

# Sensor
set_global_assignment -name VHDL_FILE Pruebas/Sensor/tb_VL53L0X.vhdd

# ============================================================================
# Directorio de salida
# ============================================================================

set_global_assignment -name VHDL_FILE Codigo/Pruebas/Motores/TestMotores.vhd
set_global_assignment -name VHDL_FILE Codigo/MaquinaEstados.vhd
set_global_assignment -name PROJECT_OUTPUT_DIRECTORY output

# ============================================================================
# Pines
# ============================================================================

# Clock y reset
set_location_assignment PIN_17  -to clk
set_location_assignment PIN_144 -to reset

# VL53L0X
set_location_assignment PIN_142 -to i2c_scl
set_location_assignment PIN_136 -to i2c_sda

# Servos
set_location_assignment PIN_118 -to servo_phi
set_location_assignment PIN_122 -to servo_theta1
set_location_assignment PIN_126 -to servo_theta2
set_location_assignment PIN_132 -to servo_theta3
set_location_assignment PIN_134 -to servo_gripper

# Motores
set_location_assignment PIN_4  -to motor_a1
set_location_assignment PIN_8  -to motor_a2
set_location_assignment PIN_31 -to motor_b1
set_location_assignment PIN_24 -to motor_b2

# LEDs
set_location_assignment PIN_3 -to led_1
set_location_assignment PIN_7 -to led_2
set_location_assignment PIN_9 -to led_3

# Sensores
set_location_assignment PIN_92 -to sensor_izq
set_location_assignment PIN_90 -to sensor_der

# Reset
set_instance_assignment -name WEAK_PULL_UP_RESISTOR ON -to reset
set_global_assignment -name LAST_QUARTUS_VERSION "13.0 SP1"